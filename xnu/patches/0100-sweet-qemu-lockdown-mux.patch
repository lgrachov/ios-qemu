diff --git a/bsd/dev/sweet_mux.c b/bsd/dev/sweet_mux.c
new file mode 100644
index 0000000..b98bd58
--- /dev/null
+++ b/bsd/dev/sweet_mux.c
@@ -0,0 +1,216 @@
+/*
+ * SWEET under QEMU: the device side of the USB mux, over QEMU's network.
+ *
+ * On an iPhone, host tools (usbmuxd + libimobiledevice) reach lockdownd and
+ * the lockdown services through a USB mux whose device side lives in the
+ * kernel: it connects kernel-owned sockets to 127.0.0.1:<port>. lockdownd
+ * relies on that. Its accept handler asks the kernel for the loopback peer's
+ * pid (TCP_PEER_PID -> the peer socket's last_pid): pid 0 means a kernel
+ * peer = a USB connection; any other loopback peer is "unsafe" and closed;
+ * a non-loopback peer is a Wi-Fi connection, closed unless wireless lockdown
+ * is enabled, and Pair is only accepted over USB.
+ *
+ * Boot-arg sweetvnet=1 (QEMU with the virtio-net en0) starts a kernel thread
+ * that listens on TCP SWEET_MUX_PORT (qemu-sweet.py forwards the host's
+ * 127.0.0.1:62079 to it). Per connection the host sends the device port as
+ * 2 bytes, big endian; a kernel socket connects to 127.0.0.1:<port> and the
+ * relay answers one status byte (0 = connected, else the errno, then
+ * closes), then copies data both ways until either side closes. The
+ * sockets are created by kernel threads, so their last_pid is 0 and
+ * lockdownd sees a USB peer. tools/ios-usbmuxd.py is the host side.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/socket.h>
+#include <sys/kpi_socket.h>
+#include <netinet/in.h>
+#include <kern/clock.h>
+#include <kern/kalloc.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <libkern/OSAtomic.h>
+#include <pexpert/pexpert.h>
+
+extern kern_return_t thread_terminate(thread_t);
+void sweet_mux_init(void);
+
+#define SWEET_MUX_PORT  62079
+#define SWEET_MUX_BUF   16384
+
+struct sweet_mux_conn {
+	socket_t host;                  /* accepted from QEMU's forward */
+	socket_t dev;                   /* kernel socket to 127.0.0.1:port */
+	SInt32   refs;                  /* one per pump thread */
+};
+
+static int sweet_mux_sleep_chan;
+
+static void
+mux_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&sweet_mux_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static int
+mux_send_all(socket_t so, const void *data, size_t len)
+{
+	size_t off = 0;
+	while (off < len) {
+		struct iovec iov = { .iov_base = (void *)((uintptr_t)data + off), .iov_len = len - off };
+		struct msghdr msg = { .msg_iov = &iov, .msg_iovlen = 1 };
+		size_t sent = 0;
+		int error = sock_send(so, &msg, 0, &sent);
+		if (error) {
+			return error;
+		}
+		if (sent == 0) {
+			return EPIPE;
+		}
+		off += sent;
+	}
+	return 0;
+}
+
+/* Copy from -> to until EOF or an error, then shut both sockets down so the
+ * other direction ends too; the last pump closes and frees the connection. */
+static void
+mux_pump(struct sweet_mux_conn *c, socket_t from, socket_t to)
+{
+	char *buf = kalloc_data(SWEET_MUX_BUF, Z_WAITOK);
+	while (buf != NULL) {
+		struct iovec iov = { .iov_base = buf, .iov_len = SWEET_MUX_BUF };
+		struct msghdr msg = { .msg_iov = &iov, .msg_iovlen = 1 };
+		size_t n = 0;
+		if (sock_receive(from, &msg, 0, &n) || n == 0 || mux_send_all(to, buf, n)) {
+			break;
+		}
+	}
+	if (buf != NULL) {
+		kfree_data(buf, SWEET_MUX_BUF);
+	}
+	(void)sock_shutdown(from, SHUT_RDWR);
+	(void)sock_shutdown(to, SHUT_RDWR);
+	if (OSDecrementAtomic(&c->refs) == 1) {
+		sock_close(c->host);
+		sock_close(c->dev);
+		kfree_type(struct sweet_mux_conn, c);
+	}
+}
+
+static void
+mux_dev_to_host(void *arg, __unused wait_result_t wr)
+{
+	struct sweet_mux_conn *c = arg;
+	mux_pump(c, c->dev, c->host);
+	thread_terminate(current_thread());
+}
+
+static void
+mux_conn_thread(void *arg, __unused wait_result_t wr)
+{
+	socket_t host = arg, dev = NULL;
+	uint8_t hdr[2], status;
+	struct iovec iov = { .iov_base = hdr, .iov_len = sizeof(hdr) };
+	struct msghdr msg = { .msg_iov = &iov, .msg_iovlen = 1 };
+	size_t n = 0;
+	int error = sock_receive(host, &msg, MSG_WAITALL, &n);
+	if (error == 0 && n != sizeof(hdr)) {
+		error = EINVAL;
+	}
+	uint16_t port = (uint16_t)((hdr[0] << 8) | hdr[1]);
+	if (error == 0) {
+		error = sock_socket(PF_INET, SOCK_STREAM, IPPROTO_TCP, NULL, NULL, &dev);
+	}
+	if (error == 0) {
+		struct sockaddr_in sin = {
+			.sin_len = sizeof(sin), .sin_family = AF_INET,
+			.sin_port = htons(port), .sin_addr.s_addr = htonl(INADDR_LOOPBACK),
+		};
+		error = sock_connect(dev, (struct sockaddr *)&sin, 0);
+	}
+	status = (uint8_t)(error > 255 ? 255 : error);
+	if (mux_send_all(host, &status, 1) == 0 && error == 0) {
+		struct sweet_mux_conn *c = kalloc_type(struct sweet_mux_conn, Z_WAITOK | Z_ZERO | Z_NOFAIL);
+		thread_t thread;
+		c->host = host;
+		c->dev = dev;
+		c->refs = 2;
+		if (kernel_thread_start(mux_dev_to_host, c, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+			mux_pump(c, host, dev);
+			thread_terminate(current_thread());
+			return;
+		}
+		kfree_type(struct sweet_mux_conn, c);
+	}
+	if (error) {
+		printf("SWEET MUX: port %u: error %d\n", port, error);
+	}
+	if (dev != NULL) {
+		sock_close(dev);
+	}
+	sock_close(host);
+	thread_terminate(current_thread());
+}
+
+static void
+mux_listen_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	socket_t ls = NULL;
+	/* sockets work once the network stack is up: retry until bind succeeds */
+	for (;;) {
+		if (sock_socket(PF_INET, SOCK_STREAM, IPPROTO_TCP, NULL, NULL, &ls) == 0) {
+			int on = 1;
+			struct sockaddr_in sin = {
+				.sin_len = sizeof(sin), .sin_family = AF_INET,
+				.sin_port = htons(SWEET_MUX_PORT), .sin_addr.s_addr = htonl(INADDR_ANY),
+			};
+			(void)sock_setsockopt(ls, SOL_SOCKET, SO_REUSEADDR, &on, sizeof(on));
+			if (sock_bind(ls, (struct sockaddr *)&sin) == 0 && sock_listen(ls, 8) == 0) {
+				break;
+			}
+			sock_close(ls);
+			ls = NULL;
+		}
+		mux_wait(1000);
+	}
+	printf("SWEET MUX: listening on TCP %d\n", SWEET_MUX_PORT);
+	for (;;) {
+		socket_t cs = NULL;
+		thread_t thread;
+		if (sock_accept(ls, NULL, 0, 0, NULL, NULL, &cs) != 0) {
+			mux_wait(100);
+			continue;
+		}
+		if (kernel_thread_start(mux_conn_thread, cs, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+		} else {
+			sock_close(cs);
+		}
+	}
+}
+
+void
+sweet_mux_init(void)
+{
+	static bool started;
+	int enabled = 0;
+	thread_t thread;
+	if (started) {
+		return;
+	}
+	started = true;
+	(void)PE_parse_boot_argn("sweetvnet", &enabled, sizeof(enabled));
+	if (!enabled) {
+		return;
+	}
+	if (kernel_thread_start(mux_listen_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
