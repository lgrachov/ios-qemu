diff --git a/bsd/net/bpf.c b/bsd/net/bpf.c
--- a/bsd/net/bpf.c
+++ b/bsd/net/bpf.c
@@ -1383,8 +1383,35 @@
 /* keep in sync with bpf_movein above: */
 #define MAX_DATALINK_HDR_LEN    (sizeof(struct firewire_header))
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/* QEMU en0 bring-up: DHCP (IPConfiguration) transmits with bpf_write. */
+static int sweet_bpf_logged;
+static int bpfwrite_sweet_inner(dev_t dev, struct uio *uio, int ioflag);
+
+int
+bpfwrite(dev_t dev, struct uio *uio, int ioflag)
+{
+	user_ssize_t resid = uio_resid(uio);
+	int error = bpfwrite_sweet_inner(dev, uio, ioflag);
+	if (error != 0 && sweet_bpf_logged < 32) {
+		struct bpf_d *d = bpf_dtab[minor(dev)];
+		ifnet_t ifp = (d != NULL && d != BPF_DEV_RESERVED && d->bd_bif != NULL) ? d->bd_bif->bif_ifp : NULL;
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		sweet_bpf_logged++;
+		printf("SWEET BPF: %s write %lld bytes on %s%d -> %d (if_flags 0x%x)\n", name,
+		    (long long)resid, ifp ? ifp->if_name : "-", ifp ? ifp->if_unit : 0, error,
+		    ifp ? ifp->if_flags : 0);
+	}
+	return error;
+}
+
+static int
+bpfwrite_sweet_inner(dev_t dev, struct uio *uio, __unused int ioflag)
+#else
 int
 bpfwrite(dev_t dev, struct uio *uio, __unused int ioflag)
+#endif
 {
 	struct bpf_d *d;
 	struct ifnet *ifp;
@@ -2044,6 +2071,14 @@
 		} else {
 			error = bpf_setif(d, ifp, true, false, false);
 		}
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+		if (sweet_bpf_logged < 32) {
+			char name[32];
+			proc_selfname(name, sizeof(name));
+			sweet_bpf_logged++;
+			printf("SWEET BPF: %s BIOCSETIF %s -> %d\n", name, ifr.ifr_name, error);
+		}
+#endif
 		break;
 	}
 
