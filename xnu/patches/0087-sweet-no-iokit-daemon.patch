diff --git a/libkern/c++/OSKext.cpp b/libkern/c++/OSKext.cpp
--- a/libkern/c++/OSKext.cpp
+++ b/libkern/c++/OSKext.cpp
@@ -1481,6 +1481,15 @@
 bool
 OSKext::iokitDaemonAvailable(void)
 {
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/*
+	 * iOS has no kernelmanagerd. With this macOS-source kernel waiting for
+	 * it, the registry root kept the daemon's busy count forever, so IOKit
+	 * never went quiet: configd's InterfaceNamer timed out and every
+	 * SCNetworkInterface caller (Settings > General > About) waited minutes.
+	 */
+	return false;
+#endif
 	int notused;
 	if (PE_parse_boot_argn("-restore", &notused, sizeof(notused))) {
 		return false;
