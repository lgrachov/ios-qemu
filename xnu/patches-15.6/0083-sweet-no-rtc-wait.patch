@@ -77,8 +77,12 @@ IOKitInitializeTime( void )
 	t.tv_sec = 30;
 	t.tv_nsec = 0;
 
+// SWEET: no IORTC driver either (the PMIC RTC is not driven); waiting only
+// cost 30 s per boot before clock_initialize_calendar starts from 0 anyway.
+#if !defined(ARM64_BOARD_CONFIG_SWEET)
 	IOService::waitForService(
 		IOService::resourceMatching("IORTC"), &t );
+#endif
 #if defined(__i386__) || defined(__x86_64__)
 	IOService::waitForService(
 		IOService::resourceMatching("IONVRAM"), &t );
