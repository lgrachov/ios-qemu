 		    (IOMobileFramebufferUserClient *)fb->fClients->getObject(i);
 		client->notify(SWEET_FB_NOTIFY_VSYNC, values, 6);
 	}
+	if (fb->fPowerOff) {
+		/* Fade out: halve every channel each vsync, then black, then idle. */
+		uint32_t step = fb->fFadeStep;
+		if (step <= 6) {
+			fb->fFadeStep = step + 1;
+		}
+		IOLockUnlock(fb->fLock);
+		if (step <= 6) {
+			for (uint32_t y = 0; y < fb->fHeight; y++) {
+				volatile uint32_t *row = (volatile uint32_t *)(fb->fPixels + (uint64_t)y * fb->fRowBytes);
+				for (uint32_t x = 0; x < fb->fWidth; x++) {
+					row[x] = step < 6 ? (row[x] >> 1) & 0x7f7f7f7f : 0;
+				}
+			}
+		}
+		sender->setTimeoutUS(SWEET_FB_VSYNC_US);
+		return;
+	}
 	bool flush = fb->fDirty && (count % fb->fFlushTicks) == 0;
 	uint8_t *rec = NULL;
 	if (flush) {
@@ -472,7 +502,33 @@ IOMobileFramebufferUserClient::externalMethod(uint32_t selector, IOExternalMetho
 			ret = kIOReturnBadArgument;
 			break;
 		}
-		memcpy(rec, args->structureInput, sizeof(rec));
+		if (args->structureInputSize >= SWEET_FB_SWAP_REC_SIZE_18) {
+			static uint32_t dumped;
+			if (dumped < 4) {
+				/* Non-zero words of the first records, to check the layout. */
+				const uint8_t *in = (const uint8_t *)args->structureInput;
+				char line[160];
+				int n = 0;
+				dumped++;
+				for (uint32_t off = 0; off + 4 <= SWEET_FB_SWAP_REC_SIZE_18; off += 4) {
+					uint32_t v = get32(in, off);
+					if (v == 0) {
+						continue;
+					}
+					n += snprintf(line + n, sizeof(line) - n, " %x=%x", off, v);
+					if (n > (int)sizeof(line) - 24) {
+						IOLog("SWEET FB: rec18%s\n", line);
+						n = 0;
+					}
+				}
+				IOLog("SWEET FB: rec18%s (end)\n", n ? line : "");
+			}
+			bzero(rec, sizeof(rec));
+			memcpy(rec + 0x50, (const uint8_t *)args->structureInput + 0x50 +
+			    SWEET_FB_SWAP_REC_SHIFT_18, sizeof(rec) - 0x50 - SWEET_FB_SWAP_REC_SHIFT_18);
+		} else {
+			memcpy(rec, args->structureInput, sizeof(rec));
+		}
 		fFB->swap(rec);
 		break;
 	}
@@ -506,6 +562,19 @@ IOMobileFramebufferUserClient::externalMethod(uint32_t selector, IOExternalMetho
 			    args->scalarInput[0] ? "on" : "off");
 		}
 		break;
+	case kSweetFBRequestPowerChange:
+		if (args->scalarInputCount >= 1) {
+			bool off = args->scalarInput[0] == 0;
+			IOLockLock(fFB->fLock);
+			if (off != fFB->fPowerOff) {
+				fFB->fPowerOff = off;
+				fFB->fFadeStep = 0;
+				fFB->fDirty = true;     /* on: redraw the latest frame */
+			}
+			IOLockUnlock(fFB->fLock);
+			IOLog("SWEET FB: display %s\n", off ? "off" : "on");
+		}
+		break;
 	case kSweetFBSwapWait:
 	default:
 		break;
