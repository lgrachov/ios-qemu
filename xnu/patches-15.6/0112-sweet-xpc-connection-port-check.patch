+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/*
+	 * SWEET has no Sandbox kext, so no message filter callbacks are ever
+	 * registered and no port carries a sandbox label: answer as for an
+	 * unlabeled service port ("nothing to check", below) instead of
+	 * KERN_NOT_SUPPORTED. iOS 18's libxpc otherwise drops every listener
+	 * check-in ("Failed to verify check-in connection port was derived from
+	 * the listener connection port", "Bogus check-in attempt").
+	 */
+	if (!mach_msg_filter_at_least(MACH_MSG_FILTER_CALLBACKS_VERSION_1) &&
+	    mach_msg_filter_callbacks.fetch_filter_policy != NULL) {
+		return KERN_NOT_SUPPORTED;
+	}
+#else
 	if (!mach_msg_filter_at_least(MACH_MSG_FILTER_CALLBACKS_VERSION_1)) {
 		return KERN_NOT_SUPPORTED;
 	}
+#endif
 
