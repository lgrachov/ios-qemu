+/*
+ * Metal remoting surface pool (boot-arg sweetmetal=1, see SweetMetal.cpp):
+ * guest RAM below phys_base that the kernel never manages (boot-args
+ * sweetmetal_pool_pa/_size, default 0xb0000000 + 1.25 GiB). QEMU shares all
+ * of guest RAM with the host helper, so a surface allocated here is memory
+ * the host GPU renders into and samples in place: no copies in either
+ * direction. Physically contiguous, first fit, page granular; when it is
+ * full, surfaces come from ordinary wired memory as before.
+ */
+#define SWEET_POOL_SPANS        1024
+
+static IOLock      *sweet_pool_lock;
+static IOMemoryMap *sweet_pool_map;
+static uint64_t     sweet_pool_pa;
+static struct { uint64_t off, len; } sweet_pool_free[SWEET_POOL_SPANS];
+static int          sweet_pool_nfree;
+static int          sweet_pool_state;   /* 0 unset, 1 on, -1 off */
+
+static bool sweet_pool_setup(void);
+
+/* sweet_surface_lock exists (sweet_surface_alloc) */
+static bool
+sweet_pool_init(void)
+{
+	IOLockLock(sweet_surface_lock);
+	bool on = sweet_pool_state != 0 ? sweet_pool_state > 0 : sweet_pool_setup();
+	IOLockUnlock(sweet_surface_lock);
+	return on;
+}
+
+static bool
+sweet_pool_setup(void)
+{
+	uint32_t enabled = 0;
+	uint64_t size = 0x50000000ULL;
+	sweet_pool_pa = 0xb0000000ULL;
+	sweet_pool_state = -1;
+	if (!PE_parse_boot_argn("sweetmetal", &enabled, sizeof(enabled)) || !enabled) {
+		return false;
+	}
+	PE_parse_boot_argn("sweetmetal_pool_pa", &sweet_pool_pa, sizeof(sweet_pool_pa));
+	PE_parse_boot_argn("sweetmetal_pool_size", &size, sizeof(size));
+	IOMemoryDescriptor *md = IOMemoryDescriptor::withPhysicalAddress(sweet_pool_pa, size, kIODirectionInOut);
+	if (md != NULL) {
+		sweet_pool_map = md->map(kIOMapCopybackCache);
+		md->release();
+	}
+	sweet_pool_lock = IOLockAlloc();
+	if (sweet_pool_map == NULL || sweet_pool_lock == NULL) {
+		IOLog("SWEET SURF: no Metal surface pool at %#llx\n", sweet_pool_pa);
+		return false;
+	}
+	sweet_pool_free[0].off = 0;
+	sweet_pool_free[0].len = size;
+	sweet_pool_nfree = 1;
+	sweet_pool_state = 1;
+	IOLog("SWEET SURF: Metal surface pool %#llx + %llu MiB\n", sweet_pool_pa, size >> 20);
+	return true;
+}
+
+/* Physical address of len bytes (page multiple), or 0. */
+static uint64_t
+sweet_pool_alloc(uint64_t len)
+{
+	uint64_t pa = 0;
+	IOLockLock(sweet_pool_lock);
+	for (int i = 0; i < sweet_pool_nfree; i++) {
+		if (sweet_pool_free[i].len >= len) {
+			pa = sweet_pool_pa + sweet_pool_free[i].off;
+			sweet_pool_free[i].off += len;
+			sweet_pool_free[i].len -= len;
+			if (sweet_pool_free[i].len == 0) {
+				memmove(&sweet_pool_free[i], &sweet_pool_free[i + 1], (sweet_pool_nfree - i - 1) * sizeof(sweet_pool_free[0]));
+				sweet_pool_nfree--;
+			}
+			break;
+		}
+	}
+	IOLockUnlock(sweet_pool_lock);
+	return pa;
+}
+
+static void
+sweet_pool_release(uint64_t pa, uint64_t len)
+{
+	uint64_t off = pa - sweet_pool_pa;
+	IOLockLock(sweet_pool_lock);
+	int i = 0;
+	while (i < sweet_pool_nfree && sweet_pool_free[i].off < off) {
+		i++;
+	}
+	bool prev = i > 0 && sweet_pool_free[i - 1].off + sweet_pool_free[i - 1].len == off;
+	bool next = i < sweet_pool_nfree && off + len == sweet_pool_free[i].off;
+	if (prev && next) {
+		sweet_pool_free[i - 1].len += len + sweet_pool_free[i].len;
+		memmove(&sweet_pool_free[i], &sweet_pool_free[i + 1], (sweet_pool_nfree - i - 1) * sizeof(sweet_pool_free[0]));
+		sweet_pool_nfree--;
+	} else if (prev) {
+		sweet_pool_free[i - 1].len += len;
+	} else if (next) {
+		sweet_pool_free[i].off = off;
+		sweet_pool_free[i].len += len;
+	} else if (sweet_pool_nfree < SWEET_POOL_SPANS) {
+		memmove(&sweet_pool_free[i + 1], &sweet_pool_free[i], (sweet_pool_nfree - i) * sizeof(sweet_pool_free[0]));
+		sweet_pool_free[i].off = off;
+		sweet_pool_free[i].len = len;
+		sweet_pool_nfree++;
+	}
+	IOLockUnlock(sweet_pool_lock);
+}
+
+uint64_t
+sweet_surface_pool_phys(SweetSurface *s)
+{
+	return s->poolPhys;
+}
