+	/*
+	 * Same rule as AppleCLCD::start (SweetFramebuffer.cpp): a panel that fits
+	 * in the iPhone X display is shown centered in it. The phone's 1080x2400
+	 * panel gets a 22,18 offset; QEMU's full 1125x2436 framebuffer none.
+	 */
+	PE_Video video;
+	PE_current_console(&video);
+	fPanelW = video.v_width ? (int)video.v_width : 1080;
+	fPanelH = video.v_height ? (int)video.v_height : 2400;
+	fLogicalW = fPanelW;
+	fLogicalH = fPanelH;
+	if (!native && fPanelW <= 1125 && fPanelH <= 2436) {
+		fLogicalW = 1125;
+		fLogicalH = 2436;
+	}
+	fOffX = (fLogicalW - fPanelW) / 2;
+	fOffY = (fLogicalH - fPanelH) / 2;
