diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index 34a3c4af8b9393c2a8d86be9178c32a9ebfe0dd8..816c1666dcbfe3269e28a3ff4c030ade852eeff5 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -5928,6 +5928,56 @@ bad:
  *		to arrays of user space pointers.
  */
 __attribute__((noinline))
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * SWEET: iOS 18 frameworks take GPU-only paths (CoreImage refuses to make a
+ * context without Metal, ...). libQEMUCPU.dylib (tools/guest/qemu-cpu) moves
+ * them to their CPU fallbacks; every exec gets it through dyld's
+ * DYLD_INSERT_LIBRARIES (AMFI's dyld policy allows DYLD_* variables and
+ * failed insertions, see sweet_amfi.c, so a missing dylib changes nothing).
+ * Not for /sbin/launchd, nor when the caller already sets the variable.
+ * Boot-arg sweetcpushim=0 turns it off.
+ */
+#define SWEET_CPU_SHIM_ENV "DYLD_INSERT_LIBRARIES=/usr/lib/qemu/libQEMUCPU.dylib"
+
+static int sweet_cpu_shim = -1;
+
+static int
+sweet_cpu_shim_env(struct image_params *imgp, int ptr_size)
+{
+	if (sweet_cpu_shim < 0) {
+		int on = 1;
+		PE_parse_boot_argn("sweetcpushim", &on, sizeof(on));
+		sweet_cpu_shim = on;
+	}
+	/* not current_proc(): under posix_spawn that is the parent (launchd) */
+	if (!sweet_cpu_shim || strcmp(imgp->ip_strings + strlen(EXECUTABLE_KEY), "/sbin/launchd") == 0) {
+		return 0;
+	}
+	static const char key[] = "DYLD_INSERT_LIBRARIES=";
+	for (char *e = imgp->ip_endargv; e < imgp->ip_strendp; e += strlen(e) + 1) {
+		if (strncmp(e, key, sizeof(key) - 1) == 0) {
+			return 0;
+		}
+	}
+	int error = exec_add_user_string(imgp, CAST_USER_ADDR_T(SWEET_CPU_SHIM_ENV), UIO_SYSSPACE, TRUE);
+	if (error) {
+		return error;
+	}
+	if (imgp->ip_argspace < ptr_size) {
+		return E2BIG;
+	}
+	imgp->ip_argspace -= ptr_size;
+	imgp->ip_envc++;
+	static int logged;
+	if (logged < 16) {
+		logged++;
+		printf("SWEET cpushim: %s gets libQEMUCPU\n", imgp->ip_strings + strlen(EXECUTABLE_KEY));
+	}
+	return 0;
+}
+#endif
+
 static int
 exec_extract_strings(struct image_params *imgp)
 {
@@ -6100,6 +6150,13 @@ exec_extract_strings(struct image_params *imgp)
 		imgp->ip_envc++;
 	}
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	error = sweet_cpu_shim_env(imgp, new_ptr_size);
+	if (error) {
+		goto bad;
+	}
+#endif
+
 	/* Save space for envv[] NULL terminator */
 	if (imgp->ip_argspace < new_ptr_size) {
 		error = E2BIG;
diff --git a/bsd/kern/sweet_amfi.c b/bsd/kern/sweet_amfi.c
index 941d0667e06c270a5f2cc6852c5e6c02ea1534fe..98aa740b1663bcf8193666bbc89a9d35b0503487 100644
--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -29,6 +29,7 @@
 #include <libkern/OSAtomic.h>
 #include <libkern/amfi/amfi.h>
 #include <mach/kern_return.h>
+#include <pexpert/pexpert.h>
 #include <sys/codesign.h>
 #include <sys/kauth.h>
 #include <sys/mount.h>
@@ -497,20 +498,27 @@ sweet_sandbox_syscall(struct proc *p, int call, user_addr_t arg)
  *
  * Call 0x5a is dyld's amfi_check_dyld_policy_self(): arg points to
  * { u64 input flags, u64 *output flags }; the output bits are what dyld may do
- * for this process (dyld4 ProcessConfig::Security, bit 0 @-path expansion,
- * 1 DYLD_* path variables, 2 custom shared cache, 3 classic fallback paths,
- * 4 printing variables, 5 failed insertions, 6 interposing, 7 embedded
- * variables). Unanswered, dyld uses 0: system binaries are fine, but apps
- * with embedded frameworks die with "Library not loaded: @rpath/...
- * (security policy does not allow @ path expansion)". SWEET answers 0x9,
- * @-paths and fallback paths, as for a normal third-party app; DYLD_*
- * variables and interposing stay off as before.
+ * for this process (AMFI's flags; iOS 18 dyld4 ProcessConfig::Security keeps
+ * them as bytes in its own order: +0x11 bit 0 @-path expansion, +0x12 bit 4
+ * printing variables, +0x13 bit 1 DYLD_* path variables (PathOverrides
+ * parses DYLD_* only with it), +0x14 bit 2 custom shared cache, +0x15 bit 3
+ * classic fallback paths, +0x16 bit 5 failed insertions, bit 6 interposing,
+ * bit 7 embedded variables; checked in dyld's Security constructor).
+ * Unanswered, dyld uses 0: system binaries are fine, but apps with embedded
+ * frameworks die with "Library not loaded: @rpath/... (security policy does
+ * not allow @ path expansion)". SWEET answers @-paths, DYLD_* path variables
+ * (for libQEMUCPU.dylib, see kern_exec.c), fallback paths and failed
+ * insertions; interposing stays off. Boot-arg sweetdyldstrict=NAME leaves
+ * failed insertions out for process NAME, so dyld stops it with the reason
+ * an inserted library did not load (shown by the kernel's CRASH line).
  */
 #define SWEET_AMFI_QUERY_BOOTARG_STATE          0x60
 #define SWEET_AMFI_BOOTARG_ENFORCEMENT_OFF      0x86ULL
 #define SWEET_AMFI_DYLD_POLICY                  0x5a
 #define SWEET_AMFI_DYLD_ALLOW_AT_PATH           0x1ULL
+#define SWEET_AMFI_DYLD_ALLOW_ENV_PATH          0x2ULL
 #define SWEET_AMFI_DYLD_ALLOW_FALLBACK_PATHS    0x8ULL
+#define SWEET_AMFI_DYLD_ALLOW_INSERT_FAILURES   0x20ULL
 
 static int
 sweet_amfi_syscall(__unused struct proc *p, int call, user_addr_t arg)
@@ -528,7 +536,19 @@ sweet_amfi_syscall(__unused struct proc *p, int call, user_addr_t arg)
 		if (error) {
 			return error;
 		}
-		uint64_t policy = SWEET_AMFI_DYLD_ALLOW_AT_PATH | SWEET_AMFI_DYLD_ALLOW_FALLBACK_PATHS;
+		static int logged;
+		if (logged < 16) {
+			logged++;
+			printf("SWEET AMFI: dyld policy query from %s (input %#llx)\n", proc_best_name(current_proc()), args.input);
+		}
+		uint64_t policy = SWEET_AMFI_DYLD_ALLOW_AT_PATH | SWEET_AMFI_DYLD_ALLOW_ENV_PATH |
+		    SWEET_AMFI_DYLD_ALLOW_FALLBACK_PATHS | SWEET_AMFI_DYLD_ALLOW_INSERT_FAILURES;
+		char strict[32];
+		if (PE_parse_boot_argn("sweetdyldstrict", strict, sizeof(strict)) &&
+		    strcmp(strict, proc_best_name(current_proc())) == 0) {
+			policy &= ~SWEET_AMFI_DYLD_ALLOW_INSERT_FAILURES;
+			printf("SWEET AMFI: dyld policy %#llx for %s (sweetdyldstrict)\n", policy, strict);
+		}
 		return copyout(&policy, args.output, sizeof(policy));
 	}
 	return ENOPOLICY;
